@model ECommerce.ViewModels.ForgetPasswordVM

@{
    ViewData["Title"] = "ResendEmailConfirmation";
}
<div class="container">
    <h1>ForgetPassword</h1>

    <h4>ForgetPassword</h4>
    <hr />
    <div class="row">
        <div class="col-md-12">
            <form asp-action="ForgetPassword">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="UserNameOrEmail" class="control-label"></label>
                    <input asp-for="UserNameOrEmail" class="form-control" />
                    <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="send" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>

    <div>
        <a asp-action="Index">Send</a>
    </div>
</div>

